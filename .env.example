# Copy to .env and fill in. .env is gitignored.
# Development key from https://developer.riotgames.com (expires every 24h).
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Your account(s), comma-separated gameName#tagLine. Used as the default --riot-id everywhere.
RIOT_IDS=yourname#na1
# The subset shown on the public dashboard (export_dashboard_data.py). Never falls back to RIOT_IDS.
PUBLISH_RIOT_IDS=yourname#na1
